{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restic-monitor.local/schemas/event-v1.schema.json",
  "title": "Restic Monitor event v1",
  "description": "Versioned, language-neutral event envelope shared by the Bash and Go reporters.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "occurred_at",
    "job_key",
    "repository_key",
    "operation",
    "client"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "workflow_id": { "$ref": "#/$defs/id" },
    "event_type": { "enum": ["run.started", "run.completed"] },
    "occurred_at": { "$ref": "#/$defs/utcDateTime" },
    "job_key": { "$ref": "#/$defs/key" },
    "repository_key": { "$ref": "#/$defs/key" },
    "source_repository_key": { "$ref": "#/$defs/key" },
    "operation": {
      "enum": ["backup", "forget", "prune", "forget_prune", "copy", "stats", "check", "restore"]
    },
    "client": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "restic_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": true
    },
    "result": { "$ref": "#/$defs/result" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "run.started" } }, "required": ["event_type"] },
      "then": { "not": { "required": ["result"] } },
      "else": { "required": ["result"] }
    },
    {
      "if": { "properties": { "operation": { "const": "copy" } }, "required": ["operation"] },
      "then": { "required": ["source_repository_key"] },
      "else": { "not": { "required": ["source_repository_key"] } }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["host"] },
      { "required": ["status"] }
    ]
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "counter": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "type": "object",
      "required": ["exit_code", "started_at", "finished_at", "duration_ms"],
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "started_at": { "$ref": "#/$defs/utcDateTime" },
        "finished_at": { "$ref": "#/$defs/utcDateTime" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "error_summary": { "type": "string", "maxLength": 1024 },
        "metrics": {
          "type": "object",
          "properties": {
            "bytes_processed": { "$ref": "#/$defs/counter" },
            "bytes_added": { "$ref": "#/$defs/counter" },
            "bytes_added_packed": { "$ref": "#/$defs/counter" },
            "files_new": { "$ref": "#/$defs/counter" },
            "files_changed": { "$ref": "#/$defs/counter" },
            "files_unmodified": { "$ref": "#/$defs/counter" },
            "snapshot_id": {
              "type": ["string", "null"],
              "pattern": "^[a-fA-F0-9]{8,64}$"
            }
          },
          "additionalProperties": true
        },
        "repository_stats": {
          "type": "object",
          "required": ["mode", "value_bytes"],
          "properties": {
            "mode": { "enum": ["restore-size", "raw-data"] },
            "value_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "total_file_count": { "$ref": "#/$defs/counter" },
            "total_blob_count": { "$ref": "#/$defs/counter" },
            "snapshots_count": { "$ref": "#/$defs/counter" },
            "total_uncompressed_size": { "$ref": "#/$defs/counter" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
