#!/usr/bin/env bash
set -u

real_restic=${RESTIC_MONITOR_RESTIC_BIN:-/usr/local/libexec/restic.real}
monitor_bin=${RESTIC_MONITOR_BIN:-/usr/local/bin/restic-monitor}

if [[ ! -x $real_restic ]]; then
  printf '%s\n' 'restic-monitor shim: real Restic executable is unavailable' >&2
  exit 127
fi

operation=${1:-}
case $operation in
  backup|forget|prune|copy|stats|check|restore) ;;
  *) exec "$real_restic" "$@" ;;
esac

if [[ $operation == forget ]]; then
  for arg in "$@"; do
    if [[ $arg == --prune ]]; then
      operation=forget_prune
      break
    fi
  done
fi

enabled=${RESTIC_MONITOR_ENABLED:-0}
if [[ ${enabled,,} != 1 && ${enabled,,} != true ]]; then
  exec "$real_restic" "$@"
fi

case $operation in
  backup) job_key=${RESTIC_MONITOR_JOB_KEY_BACKUP:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  forget) job_key=${RESTIC_MONITOR_JOB_KEY_FORGET:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  forget_prune) job_key=${RESTIC_MONITOR_JOB_KEY_FORGET_PRUNE:-${RESTIC_MONITOR_JOB_KEY_FORGET:-${RESTIC_MONITOR_JOB_KEY:-}}} ;;
  prune) job_key=${RESTIC_MONITOR_JOB_KEY_PRUNE:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  copy) job_key=${RESTIC_MONITOR_JOB_KEY_COPY:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  stats) job_key=${RESTIC_MONITOR_JOB_KEY_STATS:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  check) job_key=${RESTIC_MONITOR_JOB_KEY_CHECK:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
  restore) job_key=${RESTIC_MONITOR_JOB_KEY_RESTORE:-${RESTIC_MONITOR_JOB_KEY:-}} ;;
esac
repository_key=${RESTIC_MONITOR_REPOSITORY_KEY:-}

if [[ ! $job_key =~ ^[A-Za-z0-9._-]{1,128}$ || ! $repository_key =~ ^[A-Za-z0-9._-]{1,128}$ ]]; then
  printf '%s\n' 'restic-monitor shim: invalid or missing Job/Repository key; monitoring skipped' >&2
  exec "$real_restic" "$@"
fi
if [[ ! -x $monitor_bin ]]; then
  printf '%s\n' 'restic-monitor shim: Reporter executable is unavailable; monitoring skipped' >&2
  exec "$real_restic" "$@"
fi

if [[ -z ${RESTIC_MONITOR_TOKEN:-} && -n ${RESTIC_MONITOR_TOKEN_FILE:-} ]]; then
  if [[ -r $RESTIC_MONITOR_TOKEN_FILE ]]; then
    IFS= read -r RESTIC_MONITOR_TOKEN < "$RESTIC_MONITOR_TOKEN_FILE" || true
    export RESTIC_MONITOR_TOKEN
  else
    printf '%s\n' 'restic-monitor shim: token file is unreadable; events will remain unsent' >&2
  fi
fi

export RESTIC_MONITOR_CLIENT_NAME=${RESTIC_MONITOR_CLIENT_NAME:-restic-monitor-docker-restic}
monitor_args=(run --job "$job_key" --repository "$repository_key" --operation "$operation")
if [[ $operation == copy ]]; then
  source_repository_key=${RESTIC_MONITOR_SOURCE_REPOSITORY_KEY:-}
  if [[ ! $source_repository_key =~ ^[A-Za-z0-9._-]{1,128}$ ]]; then
    printf '%s\n' 'restic-monitor shim: copy operation requires a valid source Repository key; monitoring skipped' >&2
    exec "$real_restic" "$@"
  fi
  monitor_args+=(--source-repository "$source_repository_key")
fi

exec "$monitor_bin" "${monitor_args[@]}" --restic-bin "$real_restic" -- "$@"
